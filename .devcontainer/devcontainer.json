{
	"name": "Corona Control Ultimate V4",
	"image": "mcr.microsoft.com/devcontainers/typescript-node:20",
	"features": {
		"ghcr.io/devcontainers/features/python:1": {
			"version": "latest"
		}
	},
	"forwardPorts": [3001, 8000, 5173],
	"portsAttributes": {
		"3001": {
			"label": "Backend (Relay)",
			"onAutoForward": "notify"
		},
		"8000": {
			"label": "AI Engine (FastAPI)",
			"onAutoForward": "notify"
		},
		"5173": {
			"label": "Frontend (Vite)",
			"onAutoForward": "openBrowser"
		}
	},
	"postCreateCommand": "npm install && cd backend && npm install && cd ../ai_engine && pip install -r requirements.txt",
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"dbaeumer.vscode-eslint",
				"mrdoob.threejs-editor-extension"
			]
		}
	}
}
