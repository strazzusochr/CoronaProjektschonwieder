{
  "id": "godmodeMemorySystem01",
  "name": "GODMODE AI Memory System",
  "active": true,
  "settings": {},
  "pinData": {},
  "versionId": "c1b5f0b8-0b95-4e63-a5a8-7b89e6823201",
  "meta": null,
  "tags": [],
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "schedule-memory-refresh",
      "name": "Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [240, 280]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ ($env.OPENHANDS_ADAPTER_INTERNAL_URL || $env.OPENHANDS_ADAPTER_URL || 'http://openhands-godmode-adapter:3001') + '/health' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.OPENHANDS_API_KEY }}"
            }
          ]
        }
      },
      "id": "fetch-runtime-health",
      "name": "Fetch Runtime Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [470, 280]
    },
    {
      "parameters": {
        "jsCode": "const lines = [\n  `- ${new Date().toISOString()} MEMORY: adapter=${$json.status}`,\n  `  openhands=${$json.public_url || 'unset'}`,\n  `  trigger=${$json.trigger_url || 'local-only'}`\n];\nreturn [{ json: { learnings: lines.join('\\n') + '\\n' } }];"
      },
      "id": "shape-memory-entry",
      "name": "Shape Memory Entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 280]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst target = $env.MEMORY_VAULT_PATH;\nconst content = $json.learnings || '';\nfs.appendFileSync(target, content, 'utf8');\nreturn [{ json: { status: 'saved', path: target, bytes: Buffer.byteLength(content, 'utf8') } }];"
      },
      "id": "save-memory-entry",
      "name": "Save to Memory Vault",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [930, 280]
    }
  ],
  "connections": {
    "Every 30 Minutes": {
      "main": [
        [
          {
            "node": "Fetch Runtime Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Runtime Health": {
      "main": [
        [
          {
            "node": "Shape Memory Entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Shape Memory Entry": {
      "main": [
        [
          {
            "node": "Save to Memory Vault",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
