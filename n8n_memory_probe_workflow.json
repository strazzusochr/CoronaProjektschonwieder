  "active": false,
  "settings": {},
  "pinData": {},
  "versionId": "6f6cc8ef-4f7f-4e5d-a15f-1b1e22b08cc1",
  "meta": null,
  "tags": [],
  "nodes": [
    {
      "parameters": {},
      "id": "execute-workflow-trigger",
      "name": "When Executed by CLI",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [240, 280]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.OPENHANDS_ADAPTER_URL + '/health' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.OPENHANDS_API_KEY }}"
            }
          ]
        }
      },
      "id": "fetch-runtime-health",
      "name": "Fetch Runtime Health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 280]
    },
    {
      "parameters": {
        "jsCode": "const lines = [\n  `- ${new Date().toISOString()} MEMORY_PROBE: adapter=${$json.status}`,\n  `  openhands=${$json.public_url || 'unset'}`,\n  `  trigger=${$json.trigger_url || 'local-only'}`\n];\nreturn [{ json: { learnings: lines.join('\\n') + '\\n' } }];"
      },
      "id": "shape-memory-entry",
      "name": "Shape Memory Entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 280]
    },
    {
      "parameters": {
        "jsCode": "const fs = require('fs');\nconst target = $env.MEMORY_VAULT_PATH;\nconst content = $json.learnings || '';\nfs.appendFileSync(target, content, 'utf8');\nreturn [{ json: { status: 'saved', path: target, bytes: Buffer.byteLength(content, 'utf8') } }];"
      },
      "id": "save-memory-entry",
      "name": "Save to Memory Vault",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 280]
    }
  ],
  "connections": {
    "When Executed by CLI": {
      "main": [
        [
          {
            "node": "Fetch Runtime Health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Runtime Health": {
